# Copy to .env and adjust. Loaded with: uvicorn ... --env-file .env
SIGNALMESH_NODE_ID=GATEWAY_01
SIGNALMESH_DB_PATH=data/gateway.db
# Optional server further up the chain; leave empty when this gateway is the end point
SIGNALMESH_UPSTREAM_URL=
SIGNALMESH_NODE_ONLINE_SECONDS=30
# Comma-separated dashboard origins, or * for any
SIGNALMESH_CORS_ORIGINS=*
SIGNALMESH_LOG_LEVEL=INFO
