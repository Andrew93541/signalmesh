# TrackMate backend (server-side only; the browser never talks to it with the session token)
TRACKMATE_BACKEND_URL=http://127.0.0.1:8100
# WebSocket for live updates (browser connects with a one-time ticket)
NEXT_PUBLIC_BACKEND_WS_URL=ws://127.0.0.1:8100
# Set to "true" when served over HTTPS
SESSION_COOKIE_SECURE=false
